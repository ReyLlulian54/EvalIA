{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalIA fixture outcomes",
  "description": "Respuestas simuladas, sin llamadas a modelos ni métricas atribuidas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcomes"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "outcomes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]{2,63}$": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["raw_text"],
              "properties": {"raw_text": {"type": "string"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["error_code", "retryable"],
              "properties": {
                "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
                "retryable": {"type": "boolean"}
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
