{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalIA private publication permission review",
  "description": "Registro privado de revisión de permisos. La identidad y evidencia declaradas deben ser comprobadas por una persona; este esquema no concede derechos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_sha256", "comparison_sha256", "reviewed_at", "reviewer", "cases"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "comparison_sha256": {"$ref": "#/$defs/sha256"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 120},
    "cases": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "source_license", "basis", "evidence_reference"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
          "source_license": {"type": "string", "minLength": 1},
          "basis": {"enum": ["original_created_for_project", "third_party_permission_verified"]},
          "evidence_reference": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
