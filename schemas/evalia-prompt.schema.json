{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalIA prompt template",
  "description": "Plantilla versionada para componer una solicitud de extracción.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_id", "version", "template"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "prompt_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "template": {"type": "string", "minLength": 1}
  }
}
